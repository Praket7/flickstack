{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlickSmith",
  "version": "0.4.0",
  "identifier": "ai.flicksmith.desktop",
  "build": {
    "beforeBuildCommand": "node --experimental-strip-types build.ts",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlickSmith",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "resources": [
      "runtime/**/*"
    ]
  }
}
