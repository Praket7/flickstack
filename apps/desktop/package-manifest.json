{
  "version": "0.4.0",
  "ffmpegPolicy": "system-provided",
  "targets": [
    {
      "os": "macos",
      "formats": [
        "app",
        "dmg"
      ],
      "ffmpeg": "system-provided"
    },
    {
      "os": "windows",
      "formats": [
        "nsis",
        "msi"
      ],
      "ffmpeg": "system-provided"
    },
    {
      "os": "linux",
      "formats": [
        "appimage",
        "deb"
      ],
      "ffmpeg": "system-provided"
    }
  ],
  "nodePolicy": "system-provided",
  "nodeMinimum": "22"
}
