{
  "name": "flicksmith",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test 'packages/**/*.test.ts' 'apps/**/*.test.ts' 'tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test",
    "test:integration": "node --experimental-strip-types --test 'tests/integration/**/*.test.ts'",
    "mcp:remote": "node --experimental-strip-types apps/mcp/src/remote-server.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0",
  "description": "Local-first agent-native professional video editor with typed reversible operations, generated scenes, human-craft quality gates, Video Git, collaboration, and deterministic native rendering."
}
